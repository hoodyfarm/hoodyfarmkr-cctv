# =================================================================
# hoodyfarmkr-cctv 환경 설정 파일 (.env.example)
# CCTV, PostgreSQL DB, OCI Cloud, Gemini AI 계정 정보 관리
# =================================================================

# App Configuration
APP_NAME=hoodyfarmkr-cctv
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO

# -----------------------------------------------------------------
# 1. SmartLife / ONVIF CCTV (RTSP) 설정
# -----------------------------------------------------------------
# ONVIF_HOST: 설치하신 CCTV의 내부 IP 주소 (예: 192.168.1.100)
ONVIF_HOST=192.168.1.100

# ONVIF_PORT: SmartLife/Tuya 카메라의 ONVIF 포트 (보통 80, 8000, 8899)
ONVIF_PORT=80

# ONVIF_USER / ONVIF_PASSWORD: SmartLife 앱 -> 카메라 설정 -> ONVIF/로컬 계정 설정에서 지정한 계정
ONVIF_USER=admin
ONVIF_PASSWORD=your_cctv_password

# RTSP_STREAM_URL: 카메라의 실시간 영상 스트림 URI (ONVIF 자동 URI 실패 시 폴백)
# 형식: rtsp://<계정>:<비밀번호>@<카메라IP>:554/stream1
RTSP_STREAM_URL=rtsp://admin:your_cctv_password@192.168.1.100:554/stream1

# Sampling & Reconnect Parameters
FRAME_SAMPLING_INTERVAL_SEC=5
MOTION_DETECTION_THRESHOLD=10000.0
MAX_RTSP_RECONNECT_ATTEMPTS=5

# -----------------------------------------------------------------
# 2. PostgreSQL 데이터베이스 설정 (3단계 & Docker 배포용)
# -----------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_cctv_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cctv_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres_cctv_pass@localhost:5432/cctv_db

# -----------------------------------------------------------------
# 3. Oracle Cloud Infrastructure (OCI) 설정
# -----------------------------------------------------------------
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_REGION=ap-seoul-1

# OCI_COMPARTMENT_ID: OCI 콘솔 -> Identity -> Compartments 에서 확인한 OCID
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..example

# OCI_OBJECT_STORAGE_NAMESPACE: OCI 콘솔 -> Tenancy Details에서 확인한 Namespace
OCI_OBJECT_STORAGE_NAMESPACE=your-oci-namespace

# OCI 버킷 이름 (OCI 콘솔 Object Storage에서 생성한 버킷 이름)
OCI_BUCKET_RAW_VIDEOS=cctv-raw-videos
OCI_BUCKET_REFINED_FRAMES=cctv-refined-frames

# -----------------------------------------------------------------
# 4. Google Gemini AI API 설정 (4단계)
# -----------------------------------------------------------------
# GEMINI_API_KEY: Google AI Studio(aistudio.google.com)에서 발급받은 API 키
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------
# 5. hoodyfarmkr-fms 연동 설정
# -----------------------------------------------------------------
FMS_WEBHOOK_URL=http://localhost:3000/api/v1/cctv-events
# -----------------------------------------------------------------
# 6. Google Drive & Google Sheets FMS 연동 설정
# -----------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
GOOGLE_SHEET_ID=your_fms_google_spreadsheet_id
GOOGLE_SHEET_RANGE=Events!A:H
GOOGLE_INTEGRATION_ENABLED=true
