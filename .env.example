# =================================================================
# hoodyfarmkr-cctv 환경 설정 파일 (.env.example)
# CCTV, PostgreSQL DB, OCI Cloud, Gemini AI 계정 정보 관리
# =================================================================

# App Configuration
APP_NAME=hoodyfarmkr-cctv
ENVIRONMENT=development

# Farm identity (tagged on every webhook event) / API auth (API_KEY REQUIRED in production)
FARM_ID=my-farm
FARM_PROFILE_PATH=config/farms/hoodyfarm.yaml
API_KEY=
CORS_ALLOW_ORIGINS=
YOLO_MODEL_PATH=yolo11n.pt
# Tailscale 사설 가상망 노드 설정
TAILSCALE_HOST_URL=http://100.75.197.92:8000
TAILSCALE_HOST_3500X=100.75.197.92
TAILSCALE_HOST_5700X3D=100.75.141.52
TAILSCALE_HOST_DEV=
TAILSCALE_HOST_PROD=
PORT=8000
LOG_LEVEL=INFO

# -----------------------------------------------------------------
# 1. SmartLife / ONVIF CCTV (RTSP) 설정 - 1번 카메라 (CAM_BARN_01)
# -----------------------------------------------------------------
# ONVIF_HOST: 설치하신 CCTV의 내부 IP 주소 (예: 192.168.1.100)
ONVIF_HOST=192.168.1.100
ONVIF_PORT=8899
ONVIF_USER=admin
ONVIF_PASSWORD=your_cctv_password
RTSP_STREAM_URL=rtsp://admin:your_cctv_password@192.168.1.100:554/streamtype=1

# -----------------------------------------------------------------
# 1-2. SmartLife / ONVIF CCTV (RTSP) 설정 - 2번 카메라 (CAM_BARN_02)
# -----------------------------------------------------------------
ONVIF_HOST_CAM02=192.168.0.25
ONVIF_PORT_CAM02=8899
ONVIF_USER_CAM02=admin
ONVIF_PASSWORD_CAM02=your_cctv_password
RTSP_STREAM_URL_CAM02=rtsp://admin:your_cctv_password@192.168.0.25:554/streamtype=1

# Sampling & Reconnect Parameters
FRAME_SAMPLING_INTERVAL_SEC=5
MOTION_DETECTION_THRESHOLD=10000.0
MAX_RTSP_RECONNECT_ATTEMPTS=5

# -----------------------------------------------------------------
# 2. PostgreSQL 데이터베이스 설정 (3단계 & Docker 배포용)
# -----------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cctv_db
DATABASE_URL=postgresql+asyncpg://postgres:change_me@localhost:5432/cctv_db

# -----------------------------------------------------------------
# 3. Oracle Cloud Infrastructure (OCI) 설정
# -----------------------------------------------------------------
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_REGION=ap-seoul-1

# OCI_COMPARTMENT_ID: OCI 콘솔 -> Identity -> Compartments 에서 확인한 OCID
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..example

# OCI_OBJECT_STORAGE_NAMESPACE: OCI 콘솔 -> Tenancy Details에서 확인한 Namespace
OCI_OBJECT_STORAGE_NAMESPACE=your-oci-namespace

# OCI 버킷 이름 (OCI 콘솔 Object Storage에서 생성한 버킷 이름)
OCI_BUCKET_RAW_VIDEOS=cctv-raw-videos
OCI_BUCKET_REFINED_FRAMES=cctv-refined-frames
OCI_PAR_EXPIRY_DAYS=7
MEDIA_SIGNED_URL_EXPIRY_DAYS=7

# -----------------------------------------------------------------
# 4. 로컬 스토리지 & 디스크 가드 정책 (Disk Guard & Spool Lifecycle)
# -----------------------------------------------------------------
SPOOL_RETENTION_MINUTES=30
EVENT_RETENTION_DAYS=7
STORAGE_MAX_TOTAL_MB=2048
DISK_MIN_FREE_PERCENT=10.0

# -----------------------------------------------------------------
# 5. Google Gemini AI API 설정 (4단계)
# -----------------------------------------------------------------
# GEMINI_API_KEY: Google AI Studio(aistudio.google.com)에서 발급받은 API 키
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------
# 5. hoodyfarmkr-fms 연동 설정
# -----------------------------------------------------------------
FMS_WEBHOOK_URL=http://localhost:3000/api/v1/cctv-events
# -----------------------------------------------------------------
# 6. Google Drive & Google Sheets FMS 연동 설정
# -----------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
GOOGLE_SHEET_ID=your_fms_google_spreadsheet_id
GOOGLE_SHEET_RANGE=Events!A:H
GOOGLE_INTEGRATION_ENABLED=true
