# =================================================================
# hoodyfarmkr-cctv 환경 설정 파일 (.env)
# 사용하시는 CCTV 및 Oracle Cloud 계정 정보로 변경해주십시오.
# =================================================================

# App Configuration
APP_NAME=hoodyfarmkr-cctv
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO

# -----------------------------------------------------------------
# 1. SmartLife CCTV (ONVIF/RTSP) 설정
# -----------------------------------------------------------------
# ONVIF_HOST: 설치하신 CCTV의 내부 IP 주소 (예: 192.168.0.50 또는 라우터에서 확인)
ONVIF_HOST=192.168.1.100

# ONVIF_PORT: SmartLife/Tuya 카메라의 ONVIF 포트 (보통 80, 8000, 8899)
ONVIF_PORT=80

# ONVIF_USER / ONVIF_PASSWORD: SmartLife 앱 -> 카메라 설정 -> ONVIF/로컬 계정 설정에서 지정한 계정
ONVIF_USER=admin
ONVIF_PASSWORD=your_cctv_password

# RTSP_STREAM_URL: 카메라의 실시간 영상 스트림 URI
# 형식: rtsp://<계정>:<비밀번호>@<카메라IP>:554/stream1
RTSP_STREAM_URL=rtsp://admin:your_cctv_password@192.168.1.100:554/stream1

# -----------------------------------------------------------------
# 2. Oracle Cloud Infrastructure (OCI) 설정
# -----------------------------------------------------------------
# OCI_CONFIG_FILE: OCI API Key 발급 후 내 컴퓨터에 생성되는 config 파일 경로
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_REGION=ap-seoul-1

# OCI_COMPARTMENT_ID: OCI 콘솔 -> Identity -> Compartments 에서 확인한 OCID
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..example

# OCI_OBJECT_STORAGE_NAMESPACE: OCI 콘솔 -> Tenancy Details에서 확인한 Namespace
OCI_OBJECT_STORAGE_NAMESPACE=your-oci-namespace

# OCI 버킷 이름 (OCI 콘솔 Object Storage에서 생성한 버킷 이름)
OCI_BUCKET_RAW_VIDEOS=cctv-raw-videos
OCI_BUCKET_REFINED_FRAMES=cctv-refined-frames

# -----------------------------------------------------------------
# 3. Google Gemini AI API 설정
# -----------------------------------------------------------------
# GEMINI_API_KEY: Google AI Studio(aistudio.google.com)에서 발급받은 API 키
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# -----------------------------------------------------------------
# 4. hoodyfarmkr-fms 연동 설정
# -----------------------------------------------------------------
FMS_WEBHOOK_URL=http://localhost:3000/api/v1/cctv-events
